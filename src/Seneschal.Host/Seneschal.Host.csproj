<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Seneschal</AssemblyName>
    <RootNamespace>Seneschal</RootNamespace>
    <ApplicationIcon>seneschal.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</RepoRoot>
  </PropertyGroup>

  <!-- The release pipeline passes -p:AppVersion=1.0.37. It is not called Version on purpose: a global Version would also reach the SDK and the
       extensions, which carry their own. A build on a developer machine says it is one. -->
  <PropertyGroup>
    <Version Condition="'$(AppVersion)' != ''">$(AppVersion)</Version>
    <Version Condition="'$(AppVersion)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <!-- A copy of the app that runs from this output folder locks the files a build wants to replace (the error "being used by another
       process" on Seneschal.Sdk.dll). End it first. Only one that runs from this very folder, so an installed copy is left alone. -->
  <Target Name="StopRunningCopy" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)stop-running-copy.ps1&quot; -Folder &quot;$(OutDir.TrimEnd('\'))&quot;"
          ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seneschal.Sdk\Seneschal.Sdk.csproj" />
  </ItemGroup>

  <!-- A build from a checkout also builds the launcher into the app's folder, so a checkout is run the way an installed copy is: through
       SeneschalApp.exe, hidden, controlled by the seneschal command (dev.ps1 does it). A release publishes the launcher itself
       (release.yml) with a runtime identifier, which is why none of this applies then. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <ProjectReference Include="..\Seneschal.Launcher\Seneschal.Launcher.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLauncher" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_LauncherFiles Include="$(MSBuildThisFileDirectory)..\Seneschal.Launcher\bin\$(Configuration)\net10.0\SeneschalApp.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LauncherFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The documents the assistant reads to make an extension. They ship inside the app so an installed copy has them too. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\ui-guidelines.md" LogicalName="ui-guidelines.md" />
    <EmbeddedResource Include="..\Seneschal.Sdk\README.md" LogicalName="sdk-reference.md" />
    <EmbeddedResource Include="Assistant\Instructions\character.md" LogicalName="instruction-character.md" />
    <EmbeddedResource Include="Assistant\Instructions\guide.md" LogicalName="instruction-guide.md" />
    <EmbeddedResource Include="Assistant\Instructions\lessons.md" LogicalName="instruction-lessons.md" />
  </ItemGroup>

  <!-- Extensions that ship with the app. Seneschal ships none: extensions are separate packages that people import. An extension
       built from a project in this repository (extensions/<Name>) is listed here to be built with the app and copied next to it (and
       into a publish) as extensions/<id>/, where the app loads it like any other extension:
         <BundledExtension Include="my-tool" SourceProject="..\..\extensions\MyTool\MyTool.csproj" />
         <ProjectReference Include="@(BundledExtension->'%(SourceProject)')" ReferenceOutputAssembly="false" />
       Deleting a project in Options, Projects removes its line. -->

  <Target Name="CopyBundledExtensions" AfterTargets="Build">
    <ItemGroup>
      <_Bundled Include="$(RepoRoot)artifacts\extensions\%(BundledExtension.Identity)\**\*">
        <ExtId>%(BundledExtension.Identity)</ExtId>
      </_Bundled>
    </ItemGroup>
    <Copy SourceFiles="@(_Bundled)"
          DestinationFiles="@(_Bundled->'$(OutDir)extensions\%(ExtId)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeBundledExtensionsInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_PublishBundled Include="$(RepoRoot)artifacts\extensions\%(BundledExtension.Identity)\**\*">
        <ExtId>%(BundledExtension.Identity)</ExtId>
      </_PublishBundled>
      <ResolvedFileToPublish Include="@(_PublishBundled)"
                             RelativePath="extensions\%(_PublishBundled.ExtId)\%(_PublishBundled.RecursiveDir)%(_PublishBundled.Filename)%(_PublishBundled.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
