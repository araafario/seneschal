@inject ExtensionAssets ExtensionAssets
<!DOCTYPE html>
<html lang="en" class="nav-loading">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Seneschal.styles.css"]" />
    @* The stylesheets of the extensions that are loaded *@
    @foreach (var style in ExtensionAssets.StyleUrls)
    {
        <link rel="stylesheet" href="@style" data-extension-style />
    }
    <script>
        // Used when an extension is imported while the page is open: adds its stylesheets without a reload
        window.seneschalStyles = function (urls) {
            urls.forEach(function (url) {
                if (document.querySelector('link[data-extension-style][href="' + url + '"]')) return;
                var link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = url;
                link.setAttribute('data-extension-style', '');
                document.head.appendChild(link);
            });
        };
        // The thin bar at the top: shown from the page load and from the click on a link to another page, until the app has drawn the new page.
        // It starts in the browser, so it appears even while the app is busy building the page
        (function () {
            var root = document.documentElement, timer;
            window.seneschalNavBusy = function (on) {
                clearTimeout(timer);
                root.classList.toggle('nav-loading', on);
                if (on) timer = setTimeout(function () { root.classList.remove('nav-loading'); }, 20000);
            };
            window.seneschalNavBusy(true);
            document.addEventListener('click', function (e) {
                if (e.defaultPrevented || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
                // The assistant button turns into a ring at once, before the app has answered
                var launcher = e.target.closest && e.target.closest('.as-launcher');
                if (launcher) { launcher.classList.add('is-opening'); return; }
                var a = e.target.closest && e.target.closest('a[href]');
                if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
                var url = new URL(a.href, location.href);
                if (url.origin !== location.origin || url.pathname + url.search === location.pathname + location.search) return;
                window.seneschalNavBusy(true);
            }, true);
        })();
        // A narrow window shows the sidebar as a rail that opens over the page, so the layout asks whether the window is narrow
        window.seneschalNarrow = function () { return window.innerWidth < 800; };
        // Ctrl+K goes to the tool search, Ctrl+J to the assistant, from any page
        document.addEventListener('keydown', function (e) {
            if (!(e.ctrlKey || e.metaKey) || e.altKey || e.shiftKey) return;
            if (e.key === 'k') {
                var input = document.querySelector('.tool-search input'), button = document.querySelector('.drawer-search button');
                e.preventDefault();
                if (input) input.focus(); else if (button) button.click();
            } else if (e.key === 'j') {
                e.preventDefault();
                var launcher = document.getElementById('as-launch');
                if (launcher) launcher.click(); else { var input = document.getElementById('as-input'); if (input) input.focus(); }
            }
        });
        // A dialog takes the keyboard when it opens, so Esc closes it and Tab stays inside it (a field that asks for focus keeps it)
        new MutationObserver(function () {
            var d = document.querySelector('.mud-dialog');
            if (d && !d.contains(document.activeElement)) { var f = d.querySelector('input:not([type=hidden]), textarea') || d; if (f === d) d.setAttribute('tabindex', '-1'); f.focus({ preventScroll: true }); }
        }).observe(document.documentElement, { childList: true, subtree: true });
        // The chat keeps its newest line in view
        window.seneschalScrollEnd = function (id, force) {
            var el = document.getElementById(id);
            if (!el) return;
            if (force || el.scrollHeight - el.scrollTop - el.clientHeight < 120) el.scrollTop = el.scrollHeight;
        };
        // The chat box: Enter sends, Shift+Enter adds a line, and the box grows with its text
        window.seneschalFitInput = function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.style.height = 'auto';
            var full = el.scrollHeight;
            el.style.height = Math.min(full, 160) + 'px';
            // A scrollbar only when the text is longer than the box can grow: a fractional line height must not make a one-line box scroll
            el.style.overflowY = full > 160 ? 'auto' : 'hidden';
        };
        // "Running for 12s": the browser counts, so the panel is not redrawn every second
        window.seneschalElapsed = function () {
            document.querySelectorAll('.as-elapsed').forEach(function (el) {
                var s = Math.max(0, Math.floor((Date.now() - Number(el.dataset.since)) / 1000));
                el.textContent = s < 60 ? s + 's' : Math.floor(s / 60) + 'm ' + String(s % 60).padStart(2, '0') + 's';
            });
        };
        setInterval(window.seneschalElapsed, 1000);
        // "Picks Write the file in 24s": counted in the browser too
        window.seneschalCountdown = function () {
            document.querySelectorAll('.as-countdown').forEach(function (el) {
                var s = Math.max(0, Math.ceil((Number(el.dataset.until) - Date.now()) / 1000));
                el.textContent = s < 60 ? s + 's' : Math.floor(s / 60) + 'm ' + String(s % 60).padStart(2, '0') + 's';
            });
        };
        setInterval(window.seneschalCountdown, 1000);
        // The docked assistant: drag its left edge to change its width (the keys do the same, a double click resets it). The width goes on the page
        // while it is dragged and is saved when the drag ends
        window.seneschalDockWidth = function (px) {
            if (px > 0) document.documentElement.style.setProperty('--w-asst', px + 'px');
            else document.documentElement.style.removeProperty('--w-asst');
        };
        window.seneschalDockResize = function (id, host) {
            var el = document.getElementById(id);
            if (!el || el.dataset.ready) return;
            el.dataset.ready = '1';
            var clamp = function (w) { return Math.round(Math.max(320, Math.min(w, Math.min(900, window.innerWidth - 400)))); };
            var current = function () { return document.getElementById('as-panel').getBoundingClientRect().width; };
            el.addEventListener('pointerdown', function (e) {
                if (e.button !== 0) return;
                e.preventDefault();
                el.setPointerCapture(e.pointerId);
                document.body.classList.add('as-resizing');
                var move = function (ev) { window.seneschalDockWidth(clamp(window.innerWidth - ev.clientX)); };
                var up = function () {
                    el.removeEventListener('pointermove', move); el.removeEventListener('pointerup', up); el.removeEventListener('pointercancel', up);
                    document.body.classList.remove('as-resizing');
                    host.invokeMethodAsync('SaveDockWidth', Math.round(current()));
                };
                el.addEventListener('pointermove', move); el.addEventListener('pointerup', up); el.addEventListener('pointercancel', up);
            });
            el.addEventListener('keydown', function (e) {
                var w = current(), step = e.shiftKey ? 80 : 24;
                if (e.key === 'ArrowLeft') w += step; else if (e.key === 'ArrowRight') w -= step; else return;
                e.preventDefault();
                w = clamp(w);
                window.seneschalDockWidth(w);
                host.invokeMethodAsync('SaveDockWidth', w);
            });
            el.addEventListener('dblclick', function () { window.seneschalDockWidth(0); host.invokeMethodAsync('SaveDockWidth', 0); });
        };
        // A page that fits in the window gets no room at the bottom for the assistant button (--fab-clear is 0 then), so it has nothing to scroll to; a longer
        // page keeps the room. It is worked out with the room taken away: if the page still does not fit, the room goes back.
        (function () {
            var root = document.documentElement, queued = false;
            function scroller() {
                var main = document.querySelector('.app-main');
                return main && getComputedStyle(main).overflowY === 'auto' ? main : root;
            }
            function update() {
                queued = false;
                root.classList.add('fab-fits');
                var s = scroller();
                if (s.scrollHeight > s.clientHeight + 1) root.classList.remove('fab-fits');
            }
            function schedule() { if (!queued) { queued = true; requestAnimationFrame(update); } }
            window.addEventListener('resize', schedule);
            var timer = setInterval(function () {
                var inner = document.querySelector('.app-main-inner');
                if (!inner) return;
                clearInterval(timer);
                new ResizeObserver(schedule).observe(inner);
                schedule();
            }, 300);
        })();
        window.seneschalFocus = function (id) {
            var el = document.getElementById(id);
            if (el) el.focus();
        };
        // The viewer: a picture of a message, large, over the whole window. Click it (or the button) to see it at its own size and drag to look around, the arrows go
        // to the other pictures of that message, Esc or a click outside closes it. A message from the history has only its small copy, and says so.
        window.seneschalViewImages = function (items, start, opener) {
            if (!items.length || document.querySelector('.as-view')) return;
            var index = start, actual = false, view = document.createElement('div');
            var icon = function (d) { return '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="' + d + '"/></svg>'; };
            var ICONS = {
                close: 'M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z',
                zoomIn: 'M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14m2.5-4h-2v2H9v-2H7V9h2V7h1v2h2z',
                zoomOut: 'M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14M7 9h5v1H7z',
                prev: 'M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z',
                next: 'M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z'
            };
            view.className = 'as-view';
            view.setAttribute('role', 'dialog');
            view.setAttribute('aria-modal', 'true');
            view.setAttribute('aria-label', 'Image');
            view.innerHTML = '<div class="as-view-bar"><span class="as-view-count"></span><span class="as-view-gap"></span>' +
                '<button type="button" class="as-view-btn as-view-zoom"></button><button type="button" class="as-view-btn as-view-close" aria-label="Close" title="Close (Esc)">' + icon(ICONS.close) + '</button></div>' +
                '<div class="as-view-stage"><button type="button" class="as-view-nav as-view-prev" aria-label="Previous image" title="Previous">' + icon(ICONS.prev) + '</button>' +
                '<div class="as-view-scroll"><img class="as-view-img" alt=""></div>' +
                '<button type="button" class="as-view-nav as-view-next" aria-label="Next image" title="Next">' + icon(ICONS.next) + '</button></div><div class="as-view-note"></div>';
            var img = view.querySelector('.as-view-img'), scroll = view.querySelector('.as-view-scroll'), zoom = view.querySelector('.as-view-zoom'), count = view.querySelector('.as-view-count'), noteEl = view.querySelector('.as-view-note');
            var prev = view.querySelector('.as-view-prev'), next = view.querySelector('.as-view-next'), close = view.querySelector('.as-view-close');
            function show() {
                var item = items[index];
                actual = false;
                view.classList.remove('is-actual');
                noteEl.textContent = item.small ? 'Small copy from the history' : '';
                img.onerror = function () { img.onerror = null; img.src = item.thumb; noteEl.textContent = 'Small copy from the history'; };
                img.src = item.src;
                img.alt = 'Image ' + (index + 1) + ' of ' + items.length;
                count.textContent = items.length > 1 ? (index + 1) + ' of ' + items.length : '';
                prev.hidden = next.hidden = items.length < 2;
                zoomLabel();
            }
            function zoomLabel() {
                zoom.innerHTML = icon(actual ? ICONS.zoomOut : ICONS.zoomIn);
                zoom.setAttribute('aria-label', actual ? 'Fit to window' : 'Actual size');
                zoom.title = actual ? 'Fit to window' : 'Actual size';
            }
            function toggle() {
                actual = !actual;
                view.classList.toggle('is-actual', actual);
                scroll.scrollLeft = (scroll.scrollWidth - scroll.clientWidth) / 2;
                scroll.scrollTop = (scroll.scrollHeight - scroll.clientHeight) / 2;
                zoomLabel();
            }
            function go(step) { index = (index + step + items.length) % items.length; show(); }
            function finish() {
                document.removeEventListener('keydown', onKey, true);
                view.remove();
                if (opener && opener.focus) opener.focus();
            }
            function onKey(e) {
                if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); finish(); }
                else if (e.key === 'ArrowLeft' && items.length > 1) { e.preventDefault(); go(-1); }
                else if (e.key === 'ArrowRight' && items.length > 1) { e.preventDefault(); go(1); }
                else if (e.key === 'Tab') {
                    // Stays inside the viewer
                    var all = Array.prototype.filter.call(view.querySelectorAll('button'), function (b) { return !b.hidden; });
                    var at = all.indexOf(document.activeElement);
                    e.preventDefault();
                    all[(at + (e.shiftKey ? -1 : 1) + all.length) % all.length].focus();
                }
            }
            // A click that is the end of a drag (looking around a picture at its own size) does not zoom out
            var press = null;
            img.addEventListener('pointerdown', function (e) { if (actual) { press = { x: e.clientX, y: e.clientY, left: scroll.scrollLeft, top: scroll.scrollTop, moved: false }; img.setPointerCapture(e.pointerId); e.preventDefault(); } });
            img.addEventListener('pointermove', function (e) {
                if (!press) return;
                if (Math.abs(e.clientX - press.x) + Math.abs(e.clientY - press.y) > 4) press.moved = true;
                scroll.scrollLeft = press.left - (e.clientX - press.x);
                scroll.scrollTop = press.top - (e.clientY - press.y);
            });
            img.addEventListener('pointerup', function () { setTimeout(function () { press = null; }, 0); });
            img.addEventListener('click', function () { if (press && press.moved) return; toggle(); });
            scroll.addEventListener('click', function (e) { if (e.target === scroll) finish(); });
            view.querySelector('.as-view-stage').addEventListener('click', function (e) { if (e.target === e.currentTarget) finish(); });
            zoom.addEventListener('click', toggle);
            close.addEventListener('click', finish);
            prev.addEventListener('click', function () { go(-1); });
            next.addEventListener('click', function () { go(1); });
            document.addEventListener('keydown', onKey, true);
            // Inside the layout, where the theme colors are defined
            (document.querySelector('.mud-layout') || document.body).appendChild(view);
            show();
            close.focus();
        };
        // A picture in the chat opens the viewer, with the other pictures of the same message
        (function () {
            function open(img) {
                var group = Array.prototype.filter.call(document.querySelectorAll('.as-user-image'), function (i) { return i.dataset.group === img.dataset.group; });
                window.seneschalViewImages(group.map(function (i) { return { src: i.dataset.full || i.src, small: !i.dataset.full, thumb: i.src }; }), group.indexOf(img), img);
            }
            document.addEventListener('click', function (e) { var img = e.target.closest && e.target.closest('.as-user-image'); if (img) open(img); });
            document.addEventListener('keydown', function (e) {
                if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('as-user-image')) { e.preventDefault(); open(e.target); }
            });
        })();        // The composer: Enter sends. A picture is added by pasting, dropping, the Add image button or the Snip button; it is scaled down here, shown small above
        // the text until the message goes, and sent with it. At most four, and the page keeps no copy of them once they are sent
        window.seneschalComposer = function (inputId, host) {
            var el = document.getElementById(inputId);
            if (!el || el.dataset.ready) return;
            el.dataset.ready = '1';
            var box = document.getElementById('as-composer'), strip = document.getElementById('as-attach'), file = document.getElementById('as-file');
            var panel = document.getElementById('as-panel'), images = [], MAX = 4, noteTimer = 0;

            function note(text) {
                var old = strip.querySelector('.as-note');
                if (old) old.remove();
                var n = document.createElement('div');
                n.className = 'as-note';
                n.textContent = text;
                strip.appendChild(n);
                box.classList.add('has-images');
                clearTimeout(noteTimer);
                noteTimer = setTimeout(render, 3500);
            }
            function render() {
                strip.innerHTML = '';
                images.forEach(function (image, i) {
                    var thumb = document.createElement('div'), img = document.createElement('img'), x = document.createElement('button');
                    thumb.className = 'as-thumb';
                    img.src = image.thumb;
                    img.alt = 'Attached image ' + (i + 1);
                    x.type = 'button';
                    x.className = 'as-thumb-x';
                    x.title = 'Remove image';
                    x.setAttribute('aria-label', 'Remove image ' + (i + 1));
                    x.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>';
                    img.tabIndex = 0;
                    img.setAttribute('role', 'button');
                    img.title = 'View image';
                    var view = function () { window.seneschalViewImages(images.map(function (m) { return { src: 'data:' + m.mediaType + ';base64,' + m.data, thumb: m.thumb }; }), i, img); };
                    img.addEventListener('click', view);
                    img.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); view(); } });
                    x.addEventListener('click', function () { images.splice(i, 1); render(); el.focus(); });
                    thumb.appendChild(img);
                    thumb.appendChild(x);
                    strip.appendChild(thumb);
                });
                box.classList.toggle('has-images', images.length > 0);
            }
            // A picture as the browser holds it (an image or a canvas), scaled so its longest side is at most max
            function scaled(source, w, h, max, type) {
                var s = Math.min(1, max / Math.max(w, h)), c = document.createElement('canvas'), g;
                c.width = Math.max(1, Math.round(w * s));
                c.height = Math.max(1, Math.round(h * s));
                g = c.getContext('2d');
                if (type === 'image/jpeg') { g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height); }
                g.drawImage(source, 0, 0, c.width, c.height);
                return c;
            }
            function add(source, w, h) {
                if (images.length >= MAX) { note('Up to ' + MAX + ' images'); return; }
                // PNG keeps text sharp; a picture that is too heavy as PNG goes as JPEG
                var type = 'image/png', url = scaled(source, w, h, 1568, type).toDataURL(type);
                if (url.length > 1500000) { type = 'image/jpeg'; url = scaled(source, w, h, 1568, type).toDataURL(type, 0.85); }
                images.push({ mediaType: type, data: url.slice(url.indexOf(',') + 1), thumb: scaled(source, w, h, 360, 'image/jpeg').toDataURL('image/jpeg', 0.7) });
                render();
            }
            function addFiles(list) {
                Array.prototype.forEach.call(list, function (f) {
                    if (!/^image\/(png|jpeg|webp|gif)$/.test(f.type)) return;
                    if (f.size > 15000000) { note('That image is too large'); return; }
                    var url = URL.createObjectURL(f), img = new Image();
                    img.onload = function () { URL.revokeObjectURL(url); add(img, img.naturalWidth, img.naturalHeight); };
                    img.onerror = function () { URL.revokeObjectURL(url); note('That image could not be read'); };
                    img.src = url;
                });
            }

            // The area to keep from a captured screen: the frame fills the window, the person drags a rectangle, Enter or Use keeps it
            function pick(frame) {
                return new Promise(function (resolve) {
                    var overlay = document.createElement('div');
                    overlay.className = 'as-snip';
                    overlay.setAttribute('role', 'dialog');
                    overlay.setAttribute('aria-label', 'Snip the screen');
                    overlay.innerHTML = '<div class="as-snip-bar"><span class="as-snip-hint">Drag to choose an area</span><span class="as-snip-gap"></span>' +
                        '<button type="button" class="as-snip-cancel">Cancel</button><button type="button" class="as-snip-use">Use Whole Screen</button></div>' +
                        '<div class="as-snip-stage"><div class="as-snip-frame"><div class="as-snip-sel" hidden></div></div></div>';
                    var holder = overlay.querySelector('.as-snip-frame'), sel = overlay.querySelector('.as-snip-sel'), use = overlay.querySelector('.as-snip-use');
                    var rect = null, start = null;
                    frame.className = 'as-snip-canvas';
                    holder.insertBefore(frame, sel);
                    // Inside the layout, where the theme colors are defined (on body they would not be)
                    (document.querySelector('.mud-layout') || document.body).appendChild(overlay);
                    function at(e) {
                        var b = frame.getBoundingClientRect();
                        return { x: Math.max(0, Math.min(1, (e.clientX - b.left) / b.width)), y: Math.max(0, Math.min(1, (e.clientY - b.top) / b.height)) };
                    }
                    function draw() {
                        sel.hidden = !rect;
                        use.textContent = rect ? 'Use Selection' : 'Use Whole Screen';
                        if (!rect) return;
                        sel.style.left = rect.x * 100 + '%';
                        sel.style.top = rect.y * 100 + '%';
                        sel.style.width = rect.w * 100 + '%';
                        sel.style.height = rect.h * 100 + '%';
                    }
                    function finish(keep) {
                        document.removeEventListener('keydown', onKey, true);
                        overlay.remove();
                        if (!keep) { resolve(null); return; }
                        if (!rect) { resolve(frame); return; }
                        var x = Math.round(rect.x * frame.width), y = Math.round(rect.y * frame.height);
                        var w = Math.max(1, Math.round(rect.w * frame.width)), h = Math.max(1, Math.round(rect.h * frame.height));
                        var out = document.createElement('canvas');
                        out.width = w;
                        out.height = h;
                        out.getContext('2d').drawImage(frame, x, y, w, h, 0, 0, w, h);
                        resolve(out);
                    }
                    function onKey(e) {
                        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); finish(false); }
                        else if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); finish(true); }
                    }
                    holder.addEventListener('pointerdown', function (e) { e.preventDefault(); holder.setPointerCapture(e.pointerId); start = at(e); rect = { x: start.x, y: start.y, w: 0, h: 0 }; draw(); });
                    holder.addEventListener('pointermove', function (e) {
                        if (!start) return;
                        var p = at(e);
                        rect = { x: Math.min(start.x, p.x), y: Math.min(start.y, p.y), w: Math.abs(p.x - start.x), h: Math.abs(p.y - start.y) };
                        draw();
                    });
                    holder.addEventListener('pointerup', function () {
                        start = null;
                        // A click, or a rectangle too small to mean anything, is no selection
                        if (rect && (rect.w * frame.width < 8 || rect.h * frame.height < 8)) { rect = null; draw(); }
                    });
                    document.addEventListener('keydown', onKey, true);
                    overlay.querySelector('.as-snip-cancel').addEventListener('click', function () { finish(false); });
                    use.addEventListener('click', function () { finish(true); });
                    use.focus();
                });
            }
            // Seneschal's own window, taken by the app itself: nothing to choose, no permission to give. Tooltips are hidden for the moment so they are not in it.
            // Null when the app cannot (not Windows, or the page is not on the same machine): then the browser's own capture is used
            function captureWindow() {
                var root = document.documentElement;
                root.classList.add('is-snipping');
                return new Promise(function (r) { setTimeout(r, 200); }).then(function () {
                    return fetch('/assistant/snip', { method: 'POST', headers: { 'X-Seneschal': 'snip' } });
                }).then(function (res) {
                    if (res.status !== 200) return null;
                    return res.blob().then(function (blob) { return createImageBitmap(blob); }).then(function (bitmap) {
                        var c = document.createElement('canvas');
                        c.width = bitmap.width;
                        c.height = bitmap.height;
                        c.getContext('2d').drawImage(bitmap, 0, 0);
                        return c;
                    });
                }).catch(function () { return null; }).then(function (frame) { root.classList.remove('is-snipping'); return frame; });
            }
            function captureScreen() {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) { note('This browser cannot capture the screen'); return Promise.reject(); }
                return navigator.mediaDevices.getDisplayMedia({ video: true, audio: false }).then(function (stream) {
                    var video = document.createElement('video');
                    video.muted = true;
                    video.playsInline = true;
                    video.srcObject = stream;
                    return video.play().then(function () { return new Promise(function (r) { setTimeout(r, 250); }); }).then(function () {
                        var c = document.createElement('canvas');
                        c.width = video.videoWidth;
                        c.height = video.videoHeight;
                        c.getContext('2d').drawImage(video, 0, 0);
                        stream.getTracks().forEach(function (t) { t.stop(); });
                        return c;
                    });
                });
            }
            function snip() {
                if (images.length >= MAX) { note('Up to ' + MAX + ' images'); return; }
                captureWindow().then(function (frame) { return frame || captureScreen(); }).then(pick).then(function (cropped) {
                    if (cropped) add(cropped, cropped.width, cropped.height);
                    el.focus();
                }, function () { /* the person closed the picker, or nothing could be captured */ });
            }
            el.addEventListener('input', function () { window.seneschalFitInput(inputId); });
            el.addEventListener('paste', function (e) {
                var files = [], items = (e.clipboardData && e.clipboardData.items) || [];
                for (var i = 0; i < items.length; i++)
                    if (items[i].kind === 'file' && items[i].type.indexOf('image/') === 0) files.push(items[i].getAsFile());
                if (files.length) { e.preventDefault(); addFiles(files); }
            });
            ['dragenter', 'dragover'].forEach(function (name) {
                panel.addEventListener(name, function (e) {
                    if (!e.dataTransfer || Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') < 0) return;
                    e.preventDefault();
                    box.classList.add('is-drop');
                });
            });
            ['dragleave', 'drop'].forEach(function (name) {
                panel.addEventListener(name, function (e) {
                    if (name === 'dragleave' && panel.contains(e.relatedTarget)) return;
                    box.classList.remove('is-drop');
                    if (name === 'drop' && e.dataTransfer && e.dataTransfer.files.length) { e.preventDefault(); addFiles(e.dataTransfer.files); }
                });
            });
            document.getElementById('as-attach-btn').addEventListener('click', function () { file.click(); });
            document.getElementById('as-snip-btn').addEventListener('click', snip);
            file.addEventListener('change', function () { addFiles(file.files); file.value = ''; });
            el.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' || e.shiftKey || e.isComposing) return;
                e.preventDefault();
                var text = el.value;
                if (!text.trim() && !images.length) return;
                var sending = images.map(function (i) { return { mediaType: i.mediaType, data: i.data, thumb: i.thumb }; });
                host.invokeMethodAsync('Submit', text, sending).then(function (taken) {
                    if (!taken) return;
                    el.value = '';
                    images = [];
                    render();
                    window.seneschalFitInput(inputId);
                });
            });
        };    </script>
    <ImportMap />
