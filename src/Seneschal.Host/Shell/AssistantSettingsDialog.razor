@inject AssistantSettings Settings
@inject Seneschal.Mcp.McpRegistry Registry
@inject Seneschal.Mcp.McpAddress Address
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Assistant Settings</MudText>
    </TitleContent>
    <DialogContent>
        <div class="as-settings">
            <MudTextField T="string" Value="@Settings.ClaudePath" ValueChanged="v => Settings.ClaudePath = v" Label="Claude path" Placeholder="@_detected"
                          Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Empty uses the Claude Code on this machine" id="as-path" />
            <MudSelect T="string" Value="@(Settings.Model ?? "")" ValueChanged="v => Settings.Model = v" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense"
                       HelperText="Default uses what Claude Code is set to" id="as-model">
                @foreach (var model in AssistantModels.Choices(Settings.Model))
                {
                    <MudSelectItem T="string" Value="@model.Value">@model.Label</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch T="bool" Value="@Settings.AskBeforeChanges" ValueChanged="v => Settings.AskBeforeChanges = v" Color="Color.Primary" Label="Ask before every change" id="as-ask" />
            <div class="as-settings-note">Deleting always asks</div>

            <div class="as-settings-section">Use it from Claude Code</div>
            <div class="as-settings-note">Add Seneschal to a Claude Code of your own and its tools show up there too</div>
            <div class="as-settings-row">
                <code class="as-settings-code">@Address.Url</code>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="CopyCommandAsync" Disabled="@(Address.Url is null)" id="as-copy-command">Copy Command</MudButton>
            </div>

            <div class="as-settings-section">Tools it can use</div>
            <div class="as-settings-tools" id="as-tools">
                @foreach (var entry in _tools)
                {
                    <div class="as-settings-tool" title="@entry.Tool.Description">
                        <span class="@($"as-effect as-effect-{entry.Tool.Effect.ToString().ToLowerInvariant()}")">@entry.Tool.Effect</span>
                        <span class="as-settings-tool-name">@entry.Tool.Name</span>
                    </div>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close" id="as-close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    // Looked up once: the search walks every folder on PATH
    private string _detected = "";
    private IReadOnlyList<Seneschal.Mcp.McpEntry> _tools = [];

    protected override void OnInitialized()
    {
        _detected = ClaudeChat.Find(null) ?? "Not found";
        _tools = Registry.All();
    }

    private void Close() => MudDialog.Close();

    private async Task CopyCommandAsync()
    {
        if (Address.Url is not { } url) return;
        var command = $"claude mcp add --transport http seneschal {url} --header \"Authorization: Bearer {Settings.Secret}\"";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", command);
            Snackbar.Add("Copied", MudBlazor.Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Could not copy", MudBlazor.Severity.Error);
        }
    }
}
