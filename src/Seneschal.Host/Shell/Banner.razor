<div class="@($"banner banner-{Tone.ToString().ToLowerInvariant()}")" role="@(Tone == BannerTone.Error ? "alert" : "status")" @attributes="Attributes">
    <span class="banner-icon"><MudIcon Icon="@Icon" /></span>
    <div class="banner-text">
        <div class="banner-title">@_title</div>
        @if (!string.IsNullOrWhiteSpace(_detail))
        {
            <div class="banner-detail">@_detail</div>
        }
    </div>
    @if (Actions is not null || OnDismiss.HasDelegate)
    {
        <div class="banner-actions">
            @Actions
            @if (OnDismiss.HasDelegate)
            {
                <MudTooltip Text="Dismiss"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Inherit" Class="banner-close" OnClick="OnDismiss" aria-label="Dismiss" /></MudTooltip>
            }
        </div>
    }
</div>

@code {
    public enum BannerTone { Success, Warning, Error, Info }

    [Parameter] public BannerTone Tone { get; set; } = BannerTone.Info;

    /// <summary>A short headline. Leave empty to give <see cref="Message"/> instead.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>A second, quieter line under the title.</summary>
    [Parameter] public string? Detail { get; set; }

    /// <summary>The result of an action: the first line is the title and the lines after it are the detail.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Buttons on the right, centered with the text.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>When set, a close button is shown.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    /// <summary>Anything else (an id, for example) goes on the banner itself.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private string _title = "";
    private string? _detail;

    private string Icon => Tone switch
    {
        BannerTone.Success => Icons.Material.Outlined.CheckCircleOutline,
        BannerTone.Warning => Icons.Material.Outlined.WarningAmber,
        BannerTone.Error => Icons.Material.Outlined.ErrorOutline,
        _ => Icons.Material.Outlined.Info,
    };

    protected override void OnParametersSet()
    {
        if (Title is not null)
        {
            _title = Title;
            _detail = Detail;
            return;
        }

        var lines = (Message ?? "").Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        _title = lines.Length > 0 ? lines[0] : "";
        _detail = lines.Length > 1 ? string.Join("\n", lines.Skip(1)) : Detail;
    }
}
