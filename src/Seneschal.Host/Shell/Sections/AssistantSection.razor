@inject AssistantSettings Settings

<OptionHeader Title="Assistant" Description="How the assistant in the corner of every page runs, and how it tests what it makes" />

<h3 class="opt-group">Claude</h3>
<div class="opt-stack">
    <SettingCard Key="claude-path" Icon="@Icons.Material.Outlined.Terminal" Title="Claude Code"
                 Description="The assistant runs the Claude Code that is signed in on this machine. Leave the path empty to use the one that is found">
        <div class="sc-form">
            <MudTextField T="string" Value="@Settings.ClaudePath" ValueChanged="v => Settings.ClaudePath = v" Label="Claude path" Placeholder="@_detected"
                          Variant="Variant.Outlined" Margin="Margin.Dense" id="as-path" />
        </div>
    </SettingCard>

    <SettingCard Key="model" Icon="@Icons.Material.Outlined.Psychology" Title="Model" Description="Which model answers. Default uses what Claude Code is set to">
        <Control>
            <MudSelect T="string" Value="@(Settings.Model ?? "default")" ValueChanged="SetModel"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="sc-select" aria-label="Model" id="as-model">
                @foreach (var model in AssistantModels.Choices(Settings.Model))
                {
                    <MudSelectItem T="string" Value="@(model.Value == "" ? "default" : model.Value)">@model.Label</MudSelectItem>
                }
            </MudSelect>
        </Control>
    </SettingCard>
</div>

<h3 class="opt-group">Approvals</h3>
<p class="opt-note opt-lead">An action that needs approval waits for you, with no time limit. Turn on Always allow to skip the question</p>
<div class="opt-stack">
    <SettingCard Key="always-allow" Icon="@Icons.Material.Outlined.GppMaybe" Title="Always allow actions"
                 Description="Runs every action without asking, deleting included. Applies to every MCP client">
        <Control>
            <MudSwitch T="bool" Value="@Settings.AlwaysAllow" ValueChanged="v => Settings.AlwaysAllow = v" Color="Color.Primary" aria-label="Always allow actions" id="as-always-allow" />
        </Control>
    </SettingCard>
</div>

<h3 class="opt-group">Questions</h3>
<div class="opt-stack">
    <SettingCard Key="question-mode" Icon="@Icons.Material.Outlined.HelpOutline" Title="When the assistant asks you" Description="@ModeText">
        <Control>
            <MudSelect T="string" Value="@Settings.QuestionMode" ValueChanged="v => Settings.QuestionMode = v"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="sc-select sc-select-wide" aria-label="When the assistant asks you" id="as-question-mode">
                <MudSelectItem T="string" Value="@QuestionModes.Ask">Wait for my answer</MudSelectItem>
                <MudSelectItem T="string" Value="@QuestionModes.Timeout">Wait, then use the recommended answer</MudSelectItem>
                <MudSelectItem T="string" Value="@QuestionModes.Recommended">Use the recommended answer</MudSelectItem>
            </MudSelect>
        </Control>
    </SettingCard>
    @if (Settings.QuestionMode == QuestionModes.Timeout)
    {
        <SettingCard Key="question-wait" Icon="@Icons.Material.Outlined.Timer" Title="How long it waits" Description="You can still answer before the time is up">
            <Control>
                <MudSelect T="int" Value="@Settings.QuestionSeconds" ValueChanged="v => Settings.QuestionSeconds = v"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="sc-select" aria-label="How long it waits" id="as-question-seconds">
                    @foreach (var (seconds, label) in Waits)
                    {
                        <MudSelectItem T="int" Value="@seconds">@label</MudSelectItem>
                    }
                </MudSelect>
            </Control>
        </SettingCard>
    }
</div>

<h3 class="opt-group">Testing</h3>
<div class="opt-stack">
    <SettingCard Key="test-browser" Icon="@Icons.Material.Outlined.Preview" Title="Show the test browser"
                 Description="The assistant looks at a page it made in a browser that runs headless, with no window. Turn this on to watch it work">
        <Control>
            <MudSwitch T="bool" Value="@Settings.ShowTestBrowser" ValueChanged="v => Settings.ShowTestBrowser = v" Color="Color.Primary" aria-label="Show the test browser" id="as-show-browser" />
        </Control>
    </SettingCard>
</div>

@code {
    // Looked up once: the search walks every folder on PATH
    private string _detected = "";

    private static readonly (int Seconds, string Label)[] Waits = [(10, "10 seconds"), (30, "30 seconds"), (60, "1 minute"), (120, "2 minutes"), (300, "5 minutes")];

    private string ModeText => Settings.QuestionMode switch
    {
        QuestionModes.Recommended => "It picks the option it recommends at once, and says so",
        QuestionModes.Timeout => "It waits, then picks the option it recommends",
        _ => "It waits for your answer, as long as that takes",
    };

    protected override void OnInitialized() => _detected = ClaudeChat.Find(null) ?? "Not found";

    /// <summary>The first choice is the default, which is no model written down: Claude Code uses what it is set to.</summary>
    private void SetModel(string value) => Settings.Model = value == "default" ? null : value;
}
