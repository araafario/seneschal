@* The one page frame: container width and padding, the title bar (icon, title, actions on the right), a divider, then the content.
   Every page except the welcome page uses it, so they all look the same. *@
@if (SetTitle)
{
    <PageTitle>@Title - Seneschal</PageTitle>
}

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page-shell">
    <header class="page-header">
        @if (Icon is not null)
        {
            <MudIcon Icon="@Icon" Size="Size.Large" />
        }
        <MudText Typo="Typo.h4" Class="page-title">@Title</MudText>
        @if (Actions is not null)
        {
            <div class="page-actions">@Actions</div>
        }
    </header>
    <div class="page-divider"></div>
    <div class="page-body">@ChildContent</div>
</MudContainer>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Shown before the title. Optional.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Buttons on the right of the title bar. Optional.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>False for a page that is mounted but hidden, so it doesn't change the browser tab title.</summary>
    [Parameter] public bool SetTitle { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
