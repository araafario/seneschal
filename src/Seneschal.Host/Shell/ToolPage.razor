@implements IDisposable
@inject Favorites Favs
@inject GroupIcons GroupIconService

@* A tool inside the page frame: the app draws the title bar and the favorites button; the tool's own view is the body. *@
<PageShell Title="@Tool.Title" Icon="@GroupIconService.Tool(Tool)" SetTitle="Active">
    <Actions>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="favorite-btn" id="@($"favorite-toggle-{Tool.Id}")"
                   StartIcon="@(Favs.IsFavorite(Tool.Id) ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                   OnClick="() => Favs.Toggle(Tool.Id)">@(Favs.IsFavorite(Tool.Id) ? "Remove from favorites" : "Add to favorites")</MudButton>
    </Actions>
    <ChildContent>
        @if (_ready)
        {
            @* Keyed by the type, so an updated extension replaces the old view *@
            <DynamicComponent @key="Tool.ComponentType" Type="Tool.ComponentType" />
        }
        else
        {
            @* The frame is already on screen while the tool builds its view, which can take a while the first time *@
            <div class="page-loading" id="tool-loading" aria-busy="true">
                <MudSkeleton Width="30%" Height="32px" />
                <MudSkeleton Width="100%" Height="64px" />
                <MudSkeleton Width="100%" Height="64px" />
                <MudSkeleton Width="100%" Height="64px" />
            </div>
        }
    </ChildContent>
</PageShell>

@code {
    [Parameter, EditorRequired] public ToolMetadata Tool { get; set; } = default!;

    /// <summary>False when the page is mounted but hidden (a persistent tool the user navigated away from).</summary>
    [Parameter] public bool Active { get; set; } = true;

    private bool _ready;

    protected override void OnInitialized()
    {
        Favs.Changed += OnFavoritesChanged;
        GroupIconService.Changed += OnFavoritesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The frame has been drawn and sent: now build the tool's view, which is the slow part
        if (!firstRender) return;
        await Task.Yield();
        _ready = true;
        StateHasChanged();
    }

    public void Dispose()
    {
        Favs.Changed -= OnFavoritesChanged;
        GroupIconService.Changed -= OnFavoritesChanged;
    }

    private void OnFavoritesChanged() => _ = InvokeAsync(StateHasChanged);
}
