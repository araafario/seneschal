@implements IDisposable
@inject ClaudeChat Chat
@inject ChatHistory History
@inject Seneschal.Mcp.McpApprovals Approvals
@inject Seneschal.Mcp.McpQuestions Questions
@inject Seneschal.Mcp.McpRegistry Registry
@inject IToolRegistry Tools
@inject GroupIcons GroupIconService
@inject Seneschal.Mcp.McpAddress Address
@inject AssistantSettings Settings
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav

@* The assistant lives in the bottom right corner of every page: a round button that says what it is on hover, and a chat panel.
   The panel draws its frame first and its content a moment later, so a click is answered at once even when the app is busy. *@
@if (!_open)
{
    <button type="button" class="@($"as-launcher {(Chat.Running ? "is-busy" : "")}")" @onclick="OpenAsync" id="as-launch" title="Ctrl+J" aria-keyshortcuts="Control+J" aria-label="@(Chat.Running ? "Open the assistant, it is working" : "Open the assistant")">
        <span class="as-launcher-text">@(Chat.Running ? "Working" : "Ask your Seneschal anything")</span>
        <span class="as-launcher-icon">
            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
            @if (Approvals.Pending.Count + Questions.Pending.Count > 0)
            {
                <span class="as-launcher-badge" id="as-badge"></span>
            }
        </span>
    </button>
}
else
{
    <section class="@($"as-panel {(Docked ? "is-sidebar" : "")}")" id="as-panel" aria-label="Assistant" tabindex="-1" @onkeydown="OnPanelKey">
        @if (Docked)
        {
            <div class="as-resizer" id="as-resizer" role="separator" aria-orientation="vertical" aria-label="Resize the assistant" title="Drag to resize, double-click to reset" tabindex="0"></div>
        }
        @if (_view == View.History)
        {
            <header class="as-head">
                <MudTooltip Text="Back"><MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Color="Color.Inherit" Size="Size.Small" OnClick="() => Show(View.Chat)" id="as-back" aria-label="Back" /></MudTooltip>
                <span class="as-title">History</span>
                <span class="as-gap"></span>
                <MudTooltip Text="Close"><MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Inherit" Size="Size.Small" OnClick="Close" id="as-close-panel" aria-label="Close" /></MudTooltip>
            </header>
            <div class="as-history" id="as-history">
                @if (History.All.Count == 0)
                {
                    <div class="run-empty as-history-empty" id="as-history-empty">No past chats</div>
                }
                @foreach (var chat in History.All)
                {
                    var id = chat.Id;
                    <div class="@($"as-history-row {(id == Chat.Id ? "is-current" : "")}")" data-chat="@id">
                        <button type="button" class="as-history-open" @onclick="() => OpenChat(id)">
                            <span class="as-history-title">@chat.Title</span>
                            <span class="as-history-meta">@When(chat.Updated)</span>
                        </button>
                        <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Inherit" Size="Size.Small" Class="as-history-delete" OnClick="() => Chat.Forget(id)" aria-label="Delete" /></MudTooltip>
                    </div>
                }
            </div>
        }
        else
        {
            <header class="as-head">
                <span class="as-head-icon"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></span>
                <MudMenu Label="@ModelLabel" EndIcon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Class="as-model-menu" PopoverClass="as-menu" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" id="as-model-menu">
                    @foreach (var model in AssistantModels.Choices(Settings.Model))
                    {
                        var value = model.Value;
                        <MudMenuItem OnClick="() => Settings.Model = value">
                            <span class="@(model.Value == (Settings.Model ?? "") ? "as-model-on" : "")">@model.Label</span>
                        </MudMenuItem>
                    }
                </MudMenu>
                <span class="as-gap"></span>
                <MudMenu Icon="@(Docked ? Icons.Material.Outlined.ViewSidebar : Icons.Material.Outlined.PictureInPictureAlt)" Color="Color.Inherit" Size="Size.Small" PopoverClass="as-menu" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="Panel position" title="Panel position" id="as-dock-menu">
                    <MudMenuItem OnClick="() => Settings.Dock = Floating" Icon="@Icons.Material.Outlined.PictureInPictureAlt"><span class="@(Docked ? "" : "as-model-on")">Floating</span></MudMenuItem>
                    <MudMenuItem OnClick="() => Settings.Dock = Sidebar" Icon="@Icons.Material.Outlined.ViewSidebar"><span class="@(Docked ? "as-model-on" : "")">Sidebar</span></MudMenuItem>
                </MudMenu>
                <MudTooltip Text="History"><MudIconButton Icon="@Icons.Material.Outlined.History" Color="Color.Inherit" Size="Size.Small" OnClick="() => Show(View.History)" id="as-history-btn" aria-label="History" /></MudTooltip>
                <MudTooltip Text="New chat"><MudIconButton Icon="@Icons.Material.Outlined.AddComment" Color="Color.Inherit" Size="Size.Small" OnClick="Reset" Disabled="@(Chat.Items.Count == 0)" id="as-new" aria-label="New chat" /></MudTooltip>
                <MudTooltip Text="Settings"><MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" Size="Size.Small" OnClick="OpenSettingsAsync" id="as-settings" aria-label="Settings" /></MudTooltip>
                <MudTooltip Text="Close"><MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Inherit" Size="Size.Small" OnClick="Close" id="as-close-panel" aria-label="Close" /></MudTooltip>
            </header>
            <div class="as-bar">
                @if (Chat.Running || !_ready)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="as-progress" aria-label="Working" id="as-progress" />
                }
            </div>

            @if (!_ready)
            {
                <div class="as-loading" id="as-loading" aria-busy="true">
                    <MudSkeleton Width="40%" />
                    <MudSkeleton Width="85%" Height="14px" />
                    <MudSkeleton Width="70%" Height="14px" />
                </div>
            }
            else if (Chat.ClaudePath is null)
            {
                <div class="as-missing" id="as-missing">
                    <div class="as-missing-title">Claude Code was not found</div>
                    <div class="as-missing-sub">The assistant runs the Claude Code on this machine. Install it and sign in once with <code>claude</code> in a terminal</div>
                    <div class="as-missing-actions">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="https://docs.claude.com/en/docs/claude-code/setup" Target="_blank">Install Guide</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenSettingsAsync">Set Path</MudButton>
                    </div>
                    @ApprovalCards
                    @if (Address.Url is { } mcpUrl)
                    {
                        <div class="as-missing-alt" id="as-missing-mcp">
                            <div class="as-missing-alt-title">Or use your own MCP client</div>
                            <div class="as-missing-sub">Every tool in Seneschal works in any client that speaks MCP, such as Claude Desktop, Cursor or VS Code. Copy the setup and paste it there</div>
                            <code class="as-missing-url">@mcpUrl</code>
                            <div class="as-missing-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => CopyAsync(McpConfig(mcpUrl))" id="as-copy-config">Copy Config</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => CopyAsync(McpCommand(mcpUrl))" id="as-copy-command">Copy Command</MudButton>
                            </div>
                            <div class="as-missing-sub">The config is JSON for most clients. The command is for Claude Code. Seneschal has to be running</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="as-messages" id="as-messages">
                    @if (Chat.Items.Count == 0)
                    {
                        <div class="as-empty" id="as-empty">
                            <img class="as-empty-logo" src="seneschal.png" alt="" />
                            <div class="as-empty-title">How can I help</div>
                            <div class="as-empty-sub">Your daily helper, ready to use any tool in Seneschal for you</div>
                            @if (_suggestions.Count > 0)
                            {
                                <div class="as-suggest">
                                    @foreach (var suggestion in _suggestions)
                                    {
                                        var text = suggestion.Text;
                                        <button type="button" class="as-suggestion" @onclick="() => SendAsync(text)" disabled="@(!CanSend)">
                                            <MudIcon Icon="@suggestion.Icon" Class="as-suggestion-icon" />
                                            <span class="as-suggestion-text">@suggestion.Text</span>
                                            <span class="as-suggestion-tool">@suggestion.Tool</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @foreach (var block in Blocks())
                    {
                        @if (block.Tools is { } tools)
                        {
                            @* One tool call is a row; a run of them is one group, so many calls do not push the answer off the screen *@
                            @(tools.Count == 1 ? ToolRow(tools[0], false) : ToolGroup(tools))
                            continue;
                        }
                        var item = block.Item!;
                        @switch (item.Kind)
                        {
                            case ChatKind.User:
                                <div class="as-row as-row-user">
                                    <div class="as-user">
                                        @if (item.Images.Count > 0)
                                        {
                                            <div class="as-user-images">
                                                @for (var i = 0; i < item.Images.Count; i++)
                                                {
                                                    var image = item.Images[i];
                                                    <img class="as-user-image" src="@image.Thumb" alt="Attached image" tabindex="0" role="button" title="View image"
                                                         data-group="@item.Id" data-full="@(image.Data is null ? null : $"/assistant/image/{item.Id}/{i}")" />
                                                }
                                            </div>
                                        }
                                        @if (item.Text.Length > 0)
                                        {
                                            <div class="as-user-text">@item.Text</div>
                                        }
                                    </div>
                                </div>
                                break;
                            case ChatKind.Assistant:
                                if (item.Text.Length > 0)
                                {
                                    <div class="as-row as-row-claude">
                                        <div class="as-claude">@ChatMarkup.Render(item.Text)</div>
                                    </div>
                                }
                                break;
                            case ChatKind.Error:
                                <div class="as-error"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" /><span>@item.Text</span></div>
                                break;
                        }
                    }
                    @if (Chat.Running)
                    {
                        <div class="as-working" id="as-thinking"><span class="as-dot"></span>Running for <span class="as-elapsed" data-since="@Chat.RunStarted.ToUnixTimeMilliseconds()">0s</span></div>
                    }
                </div>

                @ApprovalCards

                @* The box: the pictures about to be sent (filled in by the browser), then the text and, at the right end, the two ways to add a picture (the text keeps the line of the messages above) *@
                <div class="as-composer" id="as-composer">
                    <div class="as-attach" id="as-attach" aria-live="polite"></div>
                    <div class="as-composer-row">
                        <textarea id="as-input" class="as-input" rows="1" placeholder="Ask Seneschal anything" disabled="@(!CanSend && !Chat.Running)"></textarea>
                        <MudTooltip Text="Add image" Placement="Placement.Top"><button type="button" class="as-tool-btn" id="as-attach-btn" aria-label="Add image" disabled="@(!CanSend)"><MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate" /></button></MudTooltip>
                        <MudTooltip Text="Snip the screen" Placement="Placement.Top"><button type="button" class="as-tool-btn" id="as-snip-btn" aria-label="Snip the screen" disabled="@(!CanSend)"><MudIcon Icon="@Icons.Material.Outlined.ContentCut" /></button></MudTooltip>
                        @if (Chat.Running)
                        {
                            <MudTooltip Text="Stop" Placement="Placement.Top"><MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Inherit" Class="sq-btn" OnClick="Chat.Stop" id="as-stop" aria-label="Stop" /></MudTooltip>
                        }
                    </div>
                    <input type="file" id="as-file" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden />
                </div>
            }
        }
    </section>
}

@code {
    /// <summary>The questions the tools ask. Shown whatever the panel shows, so a tool called by another MCP client can be answered too.</summary>
    private RenderFragment ApprovalCards => @<text>
        @foreach (var question in Questions.Pending)
        {
            var id = question.Id;
            <div class="as-approval as-question" data-question="@id">
                <div class="as-approval-head">
                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" />
                    <span class="as-approval-title">@question.Text</span>
                    <MudTooltip Text="Skip"><MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" Color="Color.Inherit" Class="as-skip" OnClick="() => Questions.Answer(id, null)" id="as-skip" aria-label="Skip" /></MudTooltip>
                </div>
                <div class="as-options" role="@(question.Multiple ? "group" : "radiogroup")">
                    @foreach (var option in question.Options)
                    {
                        var label = option.Label;
                        var on = Picked(id).Contains(label);
                        <button type="button" class="@($"as-option {(on ? "is-on" : "")}")" role="@(question.Multiple ? "checkbox" : "radio")" aria-checked="@(on ? "true" : "false")" @onclick="() => Pick(question, label)">
                            <span class="@($"as-option-mark {(question.Multiple ? "is-multi" : "")}")">@if (on) { <MudIcon Icon="@Icons.Material.Filled.Check" /> }</span>
                            <span class="as-option-text">
                                <span class="as-option-label">@label@if (option.Recommended) { <span class="as-option-rec">Recommended</span> }</span>
                                @if (!string.IsNullOrEmpty(option.Description)) { <span class="as-option-desc">@option.Description</span> }
                            </span>
                        </button>
                    }
                </div>
                @if (question.AutoAt is { } autoAt)
                {
                    @* Seneschal picks the recommended option when the time is up; the person can answer first. The seconds are counted in the browser. *@
                    <div class="as-auto" id="as-auto">Picks <b>@string.Join(", ", question.RecommendedLabels)</b> in <span class="as-countdown" data-until="@autoAt.ToUnixTimeMilliseconds()">@Remaining(autoAt)</span></div>
                }
                @if (question.AllowOther)
                {
                    <input type="text" class="as-other" placeholder="Or write your own" aria-label="Your own answer" value="@Other(id)" @oninput="e => _other[id] = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="e => OnOtherKey(question, e)" />
                }
                @if (question.Multiple)
                {
                    <div class="as-approval-actions">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Submit(question)" Disabled="@(!HasAnswer(question))" id="as-answer">Send</MudButton>
                    </div>
                }
            </div>
        }
        @foreach (var request in Approvals.Pending)
                {
                    <div class="@($"as-approval {(request.Destructive ? "as-approval-bad" : "")}")" data-approval="@request.Tool">
                        <div class="as-approval-head">
                            <MudIcon Icon="@(request.Destructive ? Icons.Material.Outlined.WarningAmber : Icons.Material.Outlined.HelpOutline)" Size="Size.Small" />
                            <span class="as-approval-title">@(request.Destructive ? "Allow this action" : "Allow this change")</span>
                            <span class="as-approval-tool">@Pretty(request.Tool)</span>
                        </div>
                        <div class="as-approval-desc">@request.Description</div>
                        @if (request.Arguments != "{}")
                        {
                            <pre class="as-tool-text">@request.Arguments</pre>
                        }
                        <div class="as-approval-actions">
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Approvals.Answer(request.Id, false)" id="as-deny">Deny</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@(request.Destructive ? Color.Error : Color.Primary)" OnClick="() => Approvals.Answer(request.Id, true)" id="as-allow">Allow</MudButton>
                        </div>
                    </div>
                }
</text>;

    private readonly Dictionary<string, HashSet<string>> _picked = [];
    private readonly Dictionary<string, string> _other = [];

    private HashSet<string> Picked(string id) => _picked.TryGetValue(id, out var set) ? set : [];

    private string Other(string id) => _other.TryGetValue(id, out var text) ? text : "";

    private bool HasAnswer(Seneschal.Mcp.Question q) => Picked(q.Id).Count > 0 || !string.IsNullOrWhiteSpace(Other(q.Id));

    /// <summary>A single choice without a text box is answered by the click. Otherwise the click only marks the row and Send answers.</summary>
    private void Pick(Seneschal.Mcp.Question question, string label)
    {
        if (!_picked.TryGetValue(question.Id, out var set)) _picked[question.Id] = set = [];
        if (question.Multiple)
        {
            if (!set.Remove(label)) set.Add(label);
            return;
        }

        set.Clear();
        set.Add(label);
        _other.Remove(question.Id);
        Submit(question);
    }

    private void OnOtherKey(Seneschal.Mcp.Question question, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && HasAnswer(question)) Submit(question);
    }

    private void Submit(Seneschal.Mcp.Question question)
    {
        var answers = Picked(question.Id).ToList();
        if (Other(question.Id).Trim() is { Length: > 0 } own)
        {
            if (!question.Multiple) answers.Clear();
            answers.Add(own);
        }
        _picked.Remove(question.Id);
        _other.Remove(question.Id);
        Questions.Answer(question.Id, answers);
    }

    private enum View
    {
        Chat,
        History,
    }

    private sealed record Suggestion(string Text, string Icon, string Tool);

    // What to try, taken from the tools that are turned on: each one offers a few requests of its own (ToolMetadata.Prompts)
    private List<Suggestion> _suggestions = [];

    // Typing stays in the browser: the text goes to the server only when Enter is pressed, so a keystroke redraws nothing
    private DotNetObjectReference<AssistantWidget>? _self;
    private bool _open;

    private const string Floating = "floating";
    private const string Sidebar = "sidebar";

    private int _appliedWidth = -1;

    private bool Docked => Settings.Dock == Sidebar;
    private bool _ready;
    private bool _wire;
    private bool _framed;
    private int _toolCount;
    private View _view = View.Chat;

    private bool CanSend => Chat.ClaudePath is not null && !Chat.Running;

    private string ModelLabel => AssistantModels.Label(Settings.Model);

    protected override void OnInitialized()
    {
        _self = DotNetObjectReference.Create(this);
        Chat.Changed += OnChanged;
        Approvals.Changed += OnChanged;
        Questions.Changed += OnChanged;
        Settings.Changed += OnChanged;
        History.Changed += OnChanged;
    }

    public void Dispose()
    {
        _self?.Dispose();
        Chat.Changed -= OnChanged;
        Approvals.Changed -= OnChanged;
        Questions.Changed -= OnChanged;
        Settings.Changed -= OnChanged;
        History.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OpenAsync()
    {
        _open = true;
        _ready = false;
        _framed = true;
        _view = View.Chat;
    }

    private void Close() => _open = false;

    private void Show(View view)
    {
        _view = view;
        _wire = view == View.Chat;
    }

    private void OpenChat(string id)
    {
        Chat.Open(id);
        Show(View.Chat);
    }

    private void OnPanelKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open) return;
        try
        {
            if (Docked)
            {
                // The panel's width is a setting of the page, so the page beside it follows while it is dragged
                if (_appliedWidth != Settings.DockWidth)
                {
                    _appliedWidth = Settings.DockWidth;
                    await JS.InvokeVoidAsync("seneschalDockWidth", _appliedWidth);
                }
                await JS.InvokeVoidAsync("seneschalDockResize", "as-resizer", _self);
            }
            if (_framed)
            {
                // The frame is on screen: now do the slow part (looking for Claude, listing the tools) and fill it in
                _framed = false;
                await Task.Yield();
                _toolCount = Registry.All().Count;
                _suggestions = BuildSuggestions();
                _ = Chat.ClaudePath;
                _ready = true;
                _wire = true;
                StateHasChanged();
            }
            else if (_wire && _ready && _view == View.Chat)
            {
                _wire = false;
                await JS.InvokeVoidAsync("seneschalComposer", "as-input", _self);
                await JS.InvokeVoidAsync("seneschalScrollEnd", "as-messages", true);
                await JS.InvokeVoidAsync("seneschalFocus", "as-input");
            }
            else if (_ready && _view == View.Chat)
            {
                await JS.InvokeVoidAsync("seneschalScrollEnd", "as-messages", false);
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser went away
        }
    }

    /// <summary>
    /// Making a new tool is always the first card, so there is something to do in a Seneschal that has no tools yet. Then three from
    /// the tools, one from each in turn so they are not all about the same thing.
    /// </summary>
    private List<Suggestion> BuildSuggestions()
    {
        var tools = Tools.All.Where(t => t.Prompts.Count > 0).ToList();
        var list = new List<Suggestion> { new("Help me create a new extension", Icons.Material.Outlined.Extension, "Seneschal") };
        for (var round = 0; round < 3 && list.Count < 4; round++)
            foreach (var tool in tools.Where(t => round < t.Prompts.Count))
                if (list.Count < 4) list.Add(new Suggestion(tool.Prompts[round], GroupIconService.Tool(tool), tool.Title));
        return list;
    }

    private string McpConfig(string url) =>
        $$"""{ "mcpServers": { "seneschal": { "type": "http", "url": "{{url}}", "headers": { "Authorization": "Bearer {{Settings.Secret}}" } } } }""";

    private string McpCommand(string url) =>
        $"claude mcp add --transport http seneschal {url} --header \"Authorization: Bearer {Settings.Secret}\"";

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("Copied", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Could not copy", Severity.Error);
        }
    }

    private async Task SendAsync(string text, IReadOnlyList<ChatImage>? images = null)
    {
        if (!CanSend || (string.IsNullOrWhiteSpace(text) && images is not { Count: > 0 })) return;
        await Chat.SendAsync(text, images);
    }

    /// <summary>Called by the browser when the docked panel has been dragged to a new width (0 is the default again).</summary>
    [JSInvokable]
    public void SaveDockWidth(int width)
    {
        _appliedWidth = width is >= 320 and <= 900 ? width : 0;
        Settings.DockWidth = _appliedWidth;
    }

    /// <summary>Called by the browser when Enter is pressed in the composer. True when the message was taken, so the box can be emptied.</summary>
    [JSInvokable]
    public async Task<bool> Submit(string text, ChatImageIn[]? images)
    {
        // The pictures are checked again here: only known types, a limited number, a limited size
        var attached = ChatImage.From(images);
        if (!CanSend || (string.IsNullOrWhiteSpace(text) && attached.Count == 0)) return false;
        _ = SendAsync(text ?? "", attached);
        return true;
    }

    private void Reset() => Chat.Reset();

    private Task OpenSettingsAsync()
    {
        Nav.NavigateTo("/options/assistant");
        return Task.CompletedTask;
    }

    /// <summary>"projects_start" is shown as "Projects Start".</summary>
    /// <summary>A line of the conversation, or a run of tool calls that follow each other (no text between them).</summary>
    private sealed record Block(ChatItem? Item, List<ChatItem>? Tools);

    private List<Block> Blocks()
    {
        var blocks = new List<Block>();
        foreach (var item in Chat.Items)
        {
            if (item.Kind == ChatKind.Tool && blocks.Count > 0 && blocks[^1].Tools is { } run) run.Add(item);
            else if (item.Kind == ChatKind.Tool) blocks.Add(new Block(null, [item]));
            else if (item.Kind == ChatKind.Assistant && item.Text.Length == 0) continue; // an empty line of text does not split a run
            else blocks.Add(new Block(item, null));
        }
        return blocks;
    }

    /// <summary>The name of one of Seneschal's own tools without the word Seneschal, which every one of them starts with.</summary>
    private static string ToolTitle(string? name)
    {
        var trimmed = (name ?? "");
        foreach (var prefix in new[] { "mcp__seneschal__", "seneschal_" })
            if (trimmed.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) { trimmed = trimmed[prefix.Length..]; break; }
        return Pretty(trimmed);
    }

    /// <summary>One tool call: a line that opens to its input and result. Inside a group the line is compact.</summary>
    private RenderFragment ToolRow(ChatItem item, bool compact) => @<details class="@($"as-tool {(compact ? "as-tool-compact" : "")} {(item.IsError ? "as-tool-error" : "")}")" data-tool="@item.ToolName">
        <summary>
            @if (!item.Done)
            {
                <span class="as-dot"></span>
            }
            else
            {
                <MudIcon Icon="@(item.IsError ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.Check)" Size="Size.Small" Class="as-tool-icon" />
            }
            <span class="as-tool-name">@ToolTitle(item.ToolName)</span>
            <span class="as-tool-args">@Brief(item.Input)</span>
        </summary>
        @if (item.Input is not null)
        {
            <div class="as-tool-label">Input</div>
            <pre class="as-tool-text">@item.Input</pre>
        }
        @if (item.Output is not null)
        {
            <div class="as-tool-label">Result</div>
            <pre class="as-tool-text">@item.Output</pre>
        }
    </details>;

    /// <summary>
    /// Two or more calls in a row as one closed line. While they run it says which one is running; when they are done, how many there were. A failure
    /// shows on the closed line, so it is never hidden inside. The person opens it to see the calls, and it stays as they left it.
    /// </summary>
    private RenderFragment ToolGroup(List<ChatItem> tools)
    {
        var running = tools.Any(t => !t.Done);
        var failed = tools.Count(t => t.IsError);
        var current = tools.LastOrDefault(t => !t.Done) ?? tools[^1];
        return @<details @key="tools[0].Id" class="@($"as-tool as-group {(failed > 0 && !running ? "as-group-bad" : "")}")" data-group="@tools[0].Id">
            <summary>
                @if (running)
                {
                    <span class="as-dot"></span>
                    <span class="as-tool-name">Running @ToolTitle(current.ToolName)</span>
                    <span class="as-tool-args">@Brief(current.Input)</span>
                }
                else
                {
                    <MudIcon Icon="@(failed > 0 ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.Check)" Size="Size.Small" Class="as-tool-icon" />
                    <span class="as-tool-name">Used @tools.Count tools</span>
                    @if (failed > 0)
                    {
                        <span class="as-group-failed">@failed failed</span>
                    }
                }
                <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" Class="as-group-chevron" />
            </summary>
            <div class="as-group-list">
                @foreach (var tool in tools)
                {
                    @ToolRow(tool, true)
                }
            </div>
        </details>;
    }
    private static string Remaining(DateTimeOffset at)
    {
        var seconds = Math.Max(0, (int)Math.Ceiling((at - DateTimeOffset.Now).TotalSeconds));
        return seconds < 60 ? $"{seconds}s" : $"{seconds / 60}m {seconds % 60:00}s";
    }

    private static string Pretty(string? name) =>
        string.Join(' ', (name ?? "").Split('_', StringSplitOptions.RemoveEmptyEntries).Select(w => char.ToUpperInvariant(w[0]) + w[1..]));

    /// <summary>The arguments of a call on one line, so a collapsed tool still says what it did.</summary>
    private static string Brief(string? input)
    {
        if (string.IsNullOrWhiteSpace(input) || input.Trim() == "{}") return "";
        try
        {
            var values = System.Text.Json.Nodes.JsonNode.Parse(input) as System.Text.Json.Nodes.JsonObject;
            return string.Join("  ", values?.Select(p => $"{p.Key}: {p.Value?.ToString().Trim('"')}") ?? []);
        }
        catch (System.Text.Json.JsonException)
        {
            return "";
        }
    }

    /// <summary>When a chat was last used, in a few words.</summary>
    private static string When(DateTimeOffset time)
    {
        var age = DateTimeOffset.Now - time;
        if (age < TimeSpan.FromMinutes(1)) return "Just now";
        if (age < TimeSpan.FromHours(1)) return $"{(int)age.TotalMinutes} min ago";
        if (time.Date == DateTimeOffset.Now.Date) return $"{(int)age.TotalHours} h ago";
        if (time.Date == DateTimeOffset.Now.Date.AddDays(-1)) return "Yesterday";
        return time.ToString("d MMM", System.Globalization.CultureInfo.InvariantCulture);
    }
}
