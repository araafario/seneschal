@inject GroupIcons GroupIconService

<MudLink Href="@($"/tools/{Tool.Id}")" Underline="Underline.None" Class="tool-link">
    <MudCard Class="tool-card" Elevation="0">
        <div class="tool-icon"><MudIcon Icon="@GroupIconService.Tool(Tool)" /></div>
        <div class="tool-text">
            <MudText Typo="Typo.subtitle2" Class="tool-title">@Tool.Title</MudText>
            <MudText Typo="Typo.body2" Class="tool-desc">@Tool.Description</MudText>
        </div>
    </MudCard>
</MudLink>

@code {
    [Parameter, EditorRequired] public ToolMetadata Tool { get; set; } = default!;
}
