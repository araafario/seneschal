@page "/tools/{Id}"
@implements IDisposable
@inject IToolRegistry Registry

@if (_tool is null)
{
    <PageShell Title="Tool not found" Icon="@Icons.Material.Outlined.ErrorOutline">
        <MudAlert Severity="Severity.Warning">No tool with the id '@Id'</MudAlert>
    </PageShell>
}
else if (!_tool.Persistent)
{
    @* Starts fresh every time it is opened; the key resets it when the URL moves from one tool to another *@
    <ToolPage @key="_tool.Id" Tool="_tool" />
}
@* A persistent tool is shown by ToolSurface in the layout, which keeps it alive while the user is on other pages *@

@code {
    [Parameter] public string Id { get; set; } = "";

    private ToolMetadata? _tool;

    protected override void OnInitialized() => Registry.Changed += OnChanged;

    public void Dispose() => Registry.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        _tool = Registry.Get(Id);
        StateHasChanged();
    });

    protected override void OnParametersSet() => _tool = Registry.Get(Id);
}
