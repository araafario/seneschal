@page "/"
@implements IDisposable
@inject IToolRegistry Registry
@inject Favorites Favs
@inject GroupIcons GroupIconService

<PageTitle>Seneschal</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page-shell home-page">
    <header class="home-head">
        <img src="@Assets["seneschal.png"]" alt="" class="home-logo" width="48" height="48" />
        <div>
            <h1 class="home-title">Seneschal</h1>
            <p class="home-tagline">Your tools and your assistant, in one place</p>
        </div>
    </header>
    <div class="home-layout">
        <div class="home-main">
            @if (FavoriteTools.Count > 0)
            {
                <section class="home-group" aria-labelledby="home-favorites">
                    <h2 class="home-group-title" id="home-favorites"><span class="home-dot" aria-hidden="true"></span><a href="@GroupSlug.FavoritesHref">Favorites</a><span class="home-count">@FavoriteTools.Count</span></h2>
                    <ToolGrid Tools="FavoriteTools" />
                </section>
            }

            @foreach (var group in Registry.All.GroupBy(t => t.Group).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase))
            {
                var id = $"home-group-{GroupSlug.From(group.Key)}";
                <section class="home-group" aria-labelledby="@id">
                    <h2 class="@($"home-group-title hue-{GroupIconService.Color(group.Key, Registry.All.Select(t => t.Group))}")" id="@id"><span class="home-dot" aria-hidden="true"></span><a href="@GroupSlug.Href(group.Key)">@group.Key</a><span class="home-count">@group.Count()</span></h2>
                    <ToolGrid Tools="group" />
                </section>
            }
            @if (!Registry.All.Any())
            {
                <div class="opt-empty" id="no-tools">
                    Nothing here yet. Import an extension in <MudLink Href="/options/extensions">Options</MudLink>, or ask the assistant to help you create one
                </div>
            }
        </div>

        <aside class="home-aside">
            <section aria-labelledby="home-start">
                <h2 class="home-group-title" id="home-start">Get Started</h2>
                <ul class="home-list">
                    @foreach (var step in Steps)
                    {
                        <li><MudLink Href="@step.Href" Underline="Underline.None" Class="home-row"><span class="home-row-title">@step.Title</span><span class="home-row-detail">@step.Detail</span></MudLink></li>
                    }
                </ul>
            </section>
            <section aria-labelledby="home-new">
                <h2 class="home-group-title" id="home-new">What's New</h2>
                <ul class="home-list">
                    @foreach (var item in Shell.WhatsNew.Items)
                    {
                        <li><MudLink Href="@item.Href" Underline="Underline.None" Class="home-row"><span class="home-row-title">@item.Title</span><span class="home-row-detail">@item.Detail</span></MudLink></li>
                    }
                </ul>
            </section>
        </aside>
    </div>
</MudContainer>

@code {
    private sealed record Step(string Title, string Detail, string Href);

    private static readonly Step[] Steps =
    [
        new("Make a tool with the assistant", "Say what you need, it writes the page, builds it and tests it", "/options/extensions/tutorial"),
        new("Connect your own AI", "Cursor, VS Code or Claude Desktop can use the same tools", "/options/mcp"),
        new("Make it yours", "Pick the icons the sidebar and Home show", "/options/appearance"),
        new("Teach the assistant", "Edit how it talks and what it remembers", "/options/instructions"),
    ];

    private List<ToolMetadata> FavoriteTools => [.. Favs.Ids.Select(id => Registry.All.FirstOrDefault(t => t.Id == id)).OfType<ToolMetadata>()];

    protected override void OnInitialized()
    {
        Registry.Changed += OnChanged;
        Favs.Changed += OnChanged;
    }

    public void Dispose()
    {
        Registry.Changed -= OnChanged;
        Favs.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
