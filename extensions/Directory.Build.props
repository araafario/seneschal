<Project>

  <!-- Every extension in this repo is built exactly like an outside author builds one: a class library against the SDK only.
       The one difference is that the SDK is a project reference here, so a change to it is picked up without packing it first. -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <ExtensionArtifacts>$(RepoRoot)artifacts\</ExtensionArtifacts>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <MudBlazorVersion>9.11.0</MudBlazorVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Compile against MudBlazor but never ship it: the app provides it -->
    <PackageReference Include="MudBlazor" Version="$(MudBlazorVersion)" ExcludeAssets="runtime" />
    <ProjectReference Include="$(RepoRoot)src\Seneschal.Sdk\Seneschal.Sdk.csproj" Private="false" />
  </ItemGroup>

</Project>
