@using Microsoft.JSInterop
@inject IJSRuntime Js
@* The page title, the favorites button and the page container come from the app: build only the tool's content here. *@
<div class="calc-page">
    <MudTextField T="string" Value="_input" ValueChanged="OnInput" Label="Expression" Placeholder="(3 + 4) * 2"
                  Immediate="true" Variant="Variant.Outlined" AutoFocus="true" Clearable="true"
                  OnKeyDown="OnKeyDown" />

    <div class="calc-result" aria-live="polite">
        @if (string.IsNullOrWhiteSpace(_input))
        {
            <span class="calc-hint">Type an expression and press Enter</span>
        }
        else if (_ok)
        {
            <span class="calc-value">@_value</span>
            <MudTooltip Text="Copy">
                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                               aria-label="Copy" OnClick="Copy" />
            </MudTooltip>
        }
        else
        {
            <span class="calc-error">@_error</span>
        }
    </div>

    <div class="calc-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_ok)" OnClick="Save">Save Result</MudButton>
    </div>

    <div class="calc-section">
        <MudText Class="calc-title">History</MudText>
        @if (_history.Count == 0)
        {
            <div class="calc-empty">No results yet</div>
        }
        else
        {
            <div class="calc-list">
                @foreach (var item in _history)
                {
                    <button type="button" class="calc-row" @onclick="() => Reuse(item)">
                        <span class="calc-row-expr">@item.Expression</span>
                        <span class="calc-row-value">@item.Value</span>
                    </button>
                }
            </div>
            <div class="calc-actions">
                <MudButton Variant="Variant.Text" OnClick="ClearHistory">Clear History</MudButton>
            </div>
        }
    </div>
</div>

@code {
    private sealed record Entry(string Expression, string Value);

    private readonly List<Entry> _history = [];
    private string _input = "";
    private string _value = "";
    private string _error = "";
    private bool _ok;

    private void OnInput(string text)
    {
        _input = text ?? "";
        Evaluate();
    }

    private void Evaluate()
    {
        if (string.IsNullOrWhiteSpace(_input))
        {
            _ok = false;
            return;
        }
        _ok = CalculatorEngine.TryEvaluate(_input, out var result, out _error);
        _value = _ok ? CalculatorEngine.Format(result) : "";
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Save();
    }

    private void Save()
    {
        if (!_ok) return;
        var expression = _input.Trim();
        if (_history.Count == 0 || _history[0].Expression != expression)
            _history.Insert(0, new Entry(expression, _value));
        if (_history.Count > 50) _history.RemoveAt(_history.Count - 1);
        _input = _value;
        Evaluate();
    }

    private void Reuse(Entry item)
    {
        _input = item.Expression;
        Evaluate();
    }

    private void ClearHistory() => _history.Clear();

    private async Task Copy() => await Js.InvokeVoidAsync("navigator.clipboard.writeText", _value);
}